# Copy to .env and adjust for your environment.

# Generate a new key for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production
DEBUG=True

# Comma-separated hostnames allowed to serve the app
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Needed in production when frontend is on another https domain
CSRF_TRUSTED_ORIGINS=

# 공동체 나무 단계별 누적 기부 달란트 (0으로 시작하는 오름차순 4개).
# 미설정 시 기본값 0,10,24,40. 기부 속도에 맞춰 재배포 없이 조정 가능.
# COMMUNITY_THRESHOLDS=0,10,24,40

# Leave unset to use SQLite. In production set e.g.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=
